# Port the Express server listens on
PORT=5000

# Comma-free single origin (or * for any) allowed to call this API.
# Set this to your deployed frontend URL in production, e.g.
# CORS_ORIGIN=https://document-summary-assistant.netlify.app
CORS_ORIGIN=*

# Free-tier Groq API key (https://console.groq.com/keys)
# Required for AI-written reviews. Without it, the app falls back to TextRank.
GROQ_API_KEY=

# Optional model override (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
